<%
/* ─── horizoncolumns.ejs ───────────────────────────────────────────────────
   Generic horizontal-scroll column layout.

   Column markers (Markdown → rendered HTML):
     <h3>…</h3>  →  labeled column  (### heading in source)
     <hr>         →  bare column     (*** at top level in source)

   <details> blocks are protected before splitting so any *** inside them
   does not create a spurious column break.                                 */

var html = page.content;

/* ── 0. Extract ARCHIVE <details> blocks before standard protection ──── */
var archiveChunks = [];
html = html.replace(
  /<details[\s\S]*?<summary[^>]*>\s*ARCHIVE\s*<\/summary>([\s\S]*?)<\/details>/gi,
  function(match, innerContent) {
    archiveChunks.push(innerContent);
    return '';
  }
);

/* ── 1. Protect remaining <details> blocks ──────────────────────────── */
var detailsMap = Object.create(null);
var detailsIdx = 0;
html = html.replace(/<details[\s\S]*?<\/details>/gi, function(match) {
  var token = '\x00D' + detailsIdx + '\x00';
  detailsMap[token] = match;
  detailsIdx++;
  return token;
});

/* ── 2. Separate preamble from column content ─────────────────────────── */
var preamble = '';
var body = html;
var firstH3 = html.search(/<h3[\s>]/i);
if (firstH3 > 0) {
  preamble = html.slice(0, firstH3);
  body = html.slice(firstH3);
} else if (firstH3 === -1) {
  /* No H3 — entire content is preamble, no columns */
  preamble = html;
  body = '';
}

/* ── 3. Split body into chunks at each <h3> or <hr> boundary ─────────── */
/* Lookahead split: each chunk starts with its own delimiter (<h3> or <hr>).
   The first element may be an empty string if body starts right at a <h3>. */
var rawChunks = body.length ? body.split(/(?=<h3[\s>])|(?=<hr[\s\/>])|(?=<hr>)/i) : [];

/* ── 4. Classify chunks and restore <details> placeholders ───────────── */
function restoreDetails(str) {
  return str.replace(/\x00D\d+\x00/g, function(tok) {
    return detailsMap[tok] !== undefined ? detailsMap[tok] : tok;
  });
}

var columns = [];
rawChunks.forEach(function(chunk) {
  if (!chunk.trim()) return;
  var embedCount = (chunk.match(/data-flickr-embed/g) || []).length;
  var h3Match = chunk.match(/^<h3[^>]*>([\s\S]*?)<\/h3>/i);
  if (h3Match) {
    /* Labeled column: extract label text, body is everything after </h3> */
    columns.push({
      type: 'labeled',
      label: h3Match[1],
      body: restoreDetails(chunk.slice(h3Match[0].length)),
      doubleEmbed: embedCount >= 2
    });
  } else {
    /* Bare column: strip the leading <hr> tag, rest is body */
    var hrMatch = chunk.match(/^<hr[^>]*\/?>/i);
    columns.push({
      type: 'bare',
      body: restoreDetails(chunk.slice(hrMatch ? hrMatch[0].length : 0)),
      doubleEmbed: embedCount >= 2
    });
  }
});
/* ── 5. Build archive columns from extracted ARCHIVE blocks ─────────── */
if (archiveChunks.length > 0) {
  var archiveHtml = archiveChunks.join('\n');

  /* Protect any <details> inside archive content */
  archiveHtml = archiveHtml.replace(/<details[\s\S]*?<\/details>/gi, function(m) {
    var tok = '\x00D' + detailsIdx + '\x00';
    detailsMap[tok] = m;
    detailsIdx++;
    return tok;
  });

  /* Split archive into chunks using same rules as main content */
  var archiveRaw = archiveHtml.split(/(?=<h3[\s>])|(?=<hr[\s\/>])|(?=<hr>)/i);

  /* Add toggle column */
  columns.push({ type: 'archive-toggle' });

  /* Add archive columns */
  archiveRaw.forEach(function(chunk) {
    if (!chunk.trim()) return;
    var embedCount = (chunk.match(/data-flickr-embed/g) || []).length;
    var h3Match = chunk.match(/^<h3[^>]*>([\s\S]*?)<\/h3>/i);
    if (h3Match) {
      columns.push({
        type: 'archived',
        label: h3Match[1],
        body: restoreDetails(chunk.slice(h3Match[0].length)),
        doubleEmbed: embedCount >= 2
      });
    } else {
      var hrMatch = chunk.match(/^<hr[^>]*\/?>/i);
      columns.push({
        type: 'archived-bare',
        body: restoreDetails(chunk.slice(hrMatch ? hrMatch[0].length : 0)),
        doubleEmbed: embedCount >= 2
      });
    }
  });
}
%>

<h2 class="mt-3"><%- page.title %></h2>

<%- restoreDetails(preamble) %>

<% if (columns.length) { %>
<div class="hcol-scroll<%= page.wide_columns ? ' hcol-scroll--wide' : '' %>">
<% columns.forEach(function(col) { %>
  <% if (col.type === 'labeled') { %>
  <div class="hcol-group">
    <div class="hcol-label"><%- col.label %></div>
    <div class="hcol-body<%= col.doubleEmbed ? ' hcol-body--double' : '' %>"><%- col.body %></div>
  </div>
  <% } else if (col.type === 'bare') { %>
  <div class="hcol-group hcol-group--bare">
    <div class="hcol-body<%= col.doubleEmbed ? ' hcol-body--double' : '' %>"><%- col.body %></div>
  </div>
  <% } else if (col.type === 'archive-toggle') { %>
  <div class="hcol-group hcol-archive-toggle" role="button" tabindex="0" aria-expanded="false">
    <div class="hcol-label">ARCHIVE</div>
  </div>
  <% } else if (col.type === 'archived' || col.type === 'archived-bare') { %>
  <div class="hcol-group<%= col.type === 'archived-bare' ? ' hcol-group--bare' : '' %> hcol-group--archived">
    <% if (col.type === 'archived') { %>
    <div class="hcol-label"><%- col.label %></div>
    <% } %>
    <div class="hcol-body<%= col.doubleEmbed ? ' hcol-body--double' : '' %>"><%- col.body %></div>
  </div>
  <% } %>
<% }); %>
</div>
<script>
(function() {
  var toggle = document.querySelector('.hcol-archive-toggle');
  if (!toggle) return;
  function doToggle() {
    var scroll = toggle.closest('.hcol-scroll');
    var open = scroll.classList.toggle('archive-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  toggle.addEventListener('click', doToggle);
  toggle.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); doToggle(); }
  });
})();
</script>
<% } %>

<%- partial('partial/giscus') %>
