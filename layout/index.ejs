<div class="row">
  <div class="column">
    <!-- Main information, edit it on theme/_config.yml -->
    <p class="owner"><%= theme.owner %></p>
    <p><%= theme.info %></p>
    <p><%= theme.desc %></p>
  </div>
</div>

<h3>Recent Posts</h3>

<% site.posts.sort('date', 'desc').limit(theme.max_post).forEach(function(post){ %>
<div class="row">
  <div class="twelve columns left mb-3">
    <a class="post-title" href="<%- url_for(post.path) %>">
      <% if (post.title == "") { %>
        no title
      <% } else { %>
        <%- post.title %>
      <% } %>
    </a>
    <p class="bottom"><small><%- full_date(post.date, 'll') %></small></p>
  </div>
</div>
<% }) %>

<h4 class="mb-2 mt-1"> <a href="<%= config.root %>archives">All Posts</a></h4>
<hr>