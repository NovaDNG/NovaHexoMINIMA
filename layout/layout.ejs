<!DOCTYPE html>
<html lang="en">

<head>

  <!-- Minima -->
  <!-- Hexo theme created by @adisaktijrs -->

  <!-- Basic Page Needs
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
  <meta charset="utf-8">

  <%
  if (!config.author) {
    config.author = ""
  }

  var title = title = config.title;
  if (is_archive()){
    title = 'All Posts - ' + config.author;
  } else if (is_post()){
    title = page.title;
  } else if (is_page()){
    title = page.title + ' - ' + config.author;
  } else if (is_tag()){
    title = 'Posts Related to ' + page.tag;
  }

  // Compute a clean description: respect explicit frontmatter, otherwise
  // strip <style>/<script>/<small class="exif"> blocks (including their text
  // content) before calling strip_html so that inline CSS and EXIF data don't
  // bleed into OG/meta previews.
  var pageDescription = (function () {
    if (page.description) return page.description;
    if (!page.content) return config.description || '';
    var cleaned = page.content
      .replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '')
      .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
      .replace(/<small[^>]*>[\s\S]*?<\/small>/gi, '');
    return strip_html(cleaned)
      .replace(/\n/g, ' ')
      .replace(/\s+/g, ' ')
      .replace(/^\s+|\s+$/g, '')
      .substring(0, 150);
  })();
  %>
  <title><%= title %></title>
  <% if (config.sitemap) { %>
  <link rel="sitemap" href="<%-config.url + config.sitemap.path %>" />
  <% } %>
  <link rel="canonical" href="<%= url.replace(/index\.html$/, '').replace(/index\.html$/, '') %>">
  <meta name="description" content="<%= pageDescription %>">
  <% if (config.keywords) { %>
  <meta name="keywords" content="<%= config.keywords %>">
  <% } %>
  <meta name="author" content="<%- config.author %>">
  <% if (is_post() || is_page()) { %>
  <meta property="og:image" content="<%-config.url + page.thumbnail %>">
  <% } else { %>
  <meta property="og:image" content="<%-config.url + theme.thumbnail %>">
  <% } %>
  <meta property="og:site_name" content="<%= config.title %>" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= url.replace(/index\.html$/, '').replace(/index\.html$/, '') %>" />

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <% if (is_post() || is_page()) { %>
  <meta name="twitter:image" content="<%-config.url + page.thumbnail %>">
  <% } else { %>
  <meta name="twitter:image" content="<%-config.url + theme.thumbnail %>">
  <% } %>
  <meta name="twitter:url" content="<%= url.replace(/index\.html$/, '').replace(/index\.html$/, '') %>" />

  <!-- Mobile Specific Metas
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style id="critical-theme-bg">
    html { background: #eae6e2; }
    html.darkmode { background: rgb(25, 25, 26); }
    body { background: transparent; }
  </style>

  <!-- Theme preflight: apply preferred theme before first paint to avoid flash -->
  <script>
    (function () {
      var isDark = false;
      try {
        var stored = localStorage.getItem('preferredTheme');
        if (stored === 'dark') {
          isDark = true;
        } else if (stored === 'light') {
          isDark = false;
        } else {
          isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        }
      } catch (e) {
        isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      }

      if (isDark) {
        document.documentElement.classList.add('darkmode');
      } else {
        document.documentElement.classList.remove('darkmode');
      }
    })();
  </script>

  <!-- Preload fonts
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
<script>
  (function(d) {
    var config = {
      kitId: 'wgq1qkn',
      scriptTimeout: 3000,
      async: true
    },
    h=d.documentElement,t=setTimeout(function(){h.className=h.className.replace(/\bwf-loading\b/g,"")+" wf-inactive";},config.scriptTimeout),tk=d.createElement("script"),f=false,s=d.getElementsByTagName("script")[0],a;h.className+=" wf-loading";tk.src='https://use.typekit.net/'+config.kitId+'.js';tk.async=true;tk.onload=tk.onreadystatechange=function(){a=this.readyState;if(f||a&&a!="complete"&&a!="loaded")return;f=true;clearTimeout(t);try{Typekit.load(config)}catch(e){}};s.parentNode.insertBefore(tk,s)
  })(document);
</script>

  <%- partial('partial/theme_init') %>

  <% if (page.yoishigure_index || page.tategaki) { %>
  <style id="critical-yoi-float-nav">
    @keyframes yoiFadeOnly {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .page-yoishigure .trans {
      animation: none;
    }

    .page-yoishigure .trans > * {
      animation: yoiFadeOnly 0.7s;
    }

    .yoi-float-nav {
      position: fixed;
      top: 8rem;
      right: 0;
      z-index: 24;
      width: 4.9rem;
      max-width: calc(100vw - 0.8rem);
      background: #EBE6E2DE;
      box-shadow: 0 6px 12px 8px rgba(0, 123, 187, 0.12);
      backdrop-filter: blur(8px) saturate(56%);
    }

    html.darkmode .yoi-float-nav {
      background: #19191ADE;
      box-shadow: 0 6px 12px 8px rgba(0, 123, 187, 0.12);
      backdrop-filter: blur(8px) saturate(67%);
    }

    .yoi-float-nav.yoi--booting {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    @media (max-width: 550px) {
      .yoi-float-nav {
        display: none;
      }
    }
  </style>
  <% } %>

  <!-- CSS
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
  <%- css('css/normalize.css') %>
  <%- css('css/skeleton.css') %>
  <%- css('css/font.css') %>
  <%- css('css/typo.css') %>
  <%- css('css/custom.css') %>
  <% if (theme.usercss) { %>
  <%- css(theme.usercss) %>
  <% } %>
  <!-- Deferred non-critical CSS -->
  <link rel="stylesheet" href="<%- url_for('css/prism-dark.css') %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%- url_for('css/prism-dark.css') %>"></noscript>
  <link rel="stylesheet" href="<%- url_for('css/prism-line-numbers.css') %>" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="<%- url_for('css/prism-line-numbers.css') %>"></noscript>
  <% if (page.yoishigure_index || page.tategaki) { %>
  <%- css('css/yoishigure.css') %>
  <% } %>

  <!-- Favicon
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
  <link rel="icon" type="image/png" href="<%- theme.favicon %>">

  <!-- Custom Theme Color Style
  –––––––––––––––––––––––––––––––––––––––––––––––––– -->
  <%- partial('partial/tcolor') %>

  <script data-goatcounter="https://novadng.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>

</head>

<body<% if (page.yoishigure_index) { %> class="page-yoishigure"<% } else if (page.tategaki) { %> class="page-yoishigure page-yoishigure-sub"<% } %>>
  <%
    function normalizeRouteForLayout(p) {
      return String(p || '')
        .replace(/^https?:\/\/[^/]+/i, '')
        .replace(/[?#].*$/, '')
        .replace(/index\.html$/i, '')
        .replace(/\.html$/i, '')
        .replace(/^\/+|\/+$/g, '');
    }

    var isPageOrPost = page.layout === 'post' || page.layout === 'page' || page.layout === 'horizoncolumns';
    var hasPageBreadcrumb = false;

    if (page.layout === 'page' && page.breadcrumb !== false) {
      var cleanPath = normalizeRouteForLayout(page.path || '');
      var segments = cleanPath ? cleanPath.split('/').filter(Boolean) : [];
      // Keep in sync with partial/path_breadcrumb.ejs: OMIT_LEVELS=1 and >=2 visible levels.
      hasPageBreadcrumb = segments.length >= 2;
    }
  %>
  <div class="container">
    <div class="row">
      <div>
        <% if (!isPageOrPost && !hasPageBreadcrumb) { %>
          <%- partial('partial/header') %>
        <% } %>
        <div class="trans">
          <% if (page.yoishigure_index) { %>
          <%- partial('partial/yoishigure_float_nav') %>
          <% } %>
          <%- body %>
          <%- partial('partial/footer') %>
          <% if (isPageOrPost && !hasPageBreadcrumb) { %>
            <%- partial('partial/pheader')  %>
          <% } %>
        </div>
      </div>

    </div>

  </div>
  <% if (page.yoishigure_index || page.tategaki) { %>
  <%- partial('partial/yoishigure_embed_preview') %>
  <% } %>
  <script>
    (function () {
      var DETAILS_ANIM_MS = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--details-anim-ms')) || 200;

      function isNativeSummary(el) {
        return el && el.tagName === 'SUMMARY' && el.parentElement && el.parentElement.tagName === 'DETAILS';
      }

      function toggleDetailsWithCloseAnim(details) {
        if (!details || details.classList.contains('is-closing')) return;

        if (details.open) {
          details.classList.add('is-closing');
          window.setTimeout(function () {
            details.open = false;
            details.classList.remove('is-closing');
          }, DETAILS_ANIM_MS);
          return;
        }

        details.open = true;
      }

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!target || !target.closest) return;

        var summary = target.closest('summary');
        if (!isNativeSummary(summary)) return;
        if (summary.closest('.tategaki-content')) return;

        event.preventDefault();
        toggleDetailsWithCloseAnim(summary.parentElement);
      }, true);

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ') return;

        var target = event.target;
        if (!isNativeSummary(target)) return;
        if (target.closest('.tategaki-content')) return;

        event.preventDefault();
        toggleDetailsWithCloseAnim(target.parentElement);
      }, true);
    })();
  </script>

</body>

</html>
