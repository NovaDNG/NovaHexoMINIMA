<%
function normalizeNavRoute(pathLike) {
  return String(pathLike || '')
    .replace(/^https?:\/\/[^/]+/i, '')
    .replace(/[?#].*$/, '')
    .replace(/index\.html$/i, '')
    .replace(/\.html$/i, '')
    .replace(/^\/+|\/+$/g, '')
    .toLowerCase();
}

var currentPath = normalizeNavRoute(page && page.path ? page.path : '');

function isNavCurrent(targetPath) {
  var normalizedTarget = normalizeNavRoute(targetPath);
  if (!normalizedTarget) {
    return currentPath === '';
  }

  return currentPath === normalizedTarget || currentPath.indexOf(normalizedTarget + '/') === 0;
}
%>

<a href="<%= config.root %>">Home</a>
<% for (name in theme.menu) { %>
  <% if (theme.menu[name]) { %>
  <a href="<%- url_for(theme.menu[name]) %>"<% if (isNavCurrent(theme.menu[name])) { %> class="is-active" aria-current="page"<% } %>><%- name %></a>
  <% } %>
<% } %>
<% if (theme.email) { %>
  <% if (typeof obfuscate === "function") { %>
    <a href="mailto:<%- obfuscate(theme.email) %>" target="_blank">Email</a>
  <% } else { %>
    <a href="mailto:<%= theme.email %>" target="_blank">Email</a>
  <% } %>
<% } %>
