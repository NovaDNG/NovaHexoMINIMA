<script>
  (function () {
    var portraitQuery = window.matchMedia('(orientation: portrait)');
    var archiveScroll = document.querySelector('.archive-scroll');
    if (archiveScroll && window.createMomentumScroller) {
      var addVelocity = window.createMomentumScroller(archiveScroll);
      archiveScroll.addEventListener('wheel', function (event) {
        if (portraitQuery.matches) return;
        if (Math.abs(event.deltaX) >= Math.abs(event.deltaY)) return;
        var maxScrollLeft = archiveScroll.scrollWidth - archiveScroll.clientWidth;
        if (maxScrollLeft <= 0) return;
        var atStart = archiveScroll.scrollLeft <= 0.5;
        var atEnd = archiveScroll.scrollLeft >= maxScrollLeft - 0.5;
        if ((event.deltaY > 0 && atEnd) || (event.deltaY < 0 && atStart)) return;
        event.preventDefault();
        addVelocity(event.deltaY);
      }, { passive: false });
    }
  })();
</script>
