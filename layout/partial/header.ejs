<header id="header" class="site-header">
<div class="row">
  <div class="two columns mode-col">
    <h3 class="mt-2 mode">
      <div data-theme-role="dark" onclick="setDarkMode(true)"><%= theme.switch_dark %></div>
      <div data-theme-role="light" onclick="setDarkMode(false)" class="hidden"><%= theme.switch_light %></div>
    </h3>
  </div>

  <div class="six columns ml-1">
    <h3 class="mt-2">
      <%= theme.title %>
    </h3>
  </div>

  <div class="twelve columns">
    <div class="row">
      <div class="nine columns nav left">
        <%- partial('partial/_nav-menu') %>
      </div>
    </div>
    <hr>
  </div>
</div>
</header>