<script>
  (function () {
    // Archive toggle
    var toggle = document.querySelector('.hcol-archive-toggle');
    if (toggle) {
      function doToggle() {
        var scroll = toggle.closest('.hcol-scroll');
        var open = scroll.classList.toggle('archive-open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      toggle.addEventListener('click', doToggle);
      toggle.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); doToggle(); }
      });
    }

    // Wheel → horizontal scroll momentum
    // Negated deltaY: LTR layout reads left-to-right, so scroll-down advances rightward
    // (opposite sign from tategaki which uses vertical-rl reading direction)
    var portraitQuery = window.matchMedia('(orientation: portrait)');
    var hcolScroll = document.querySelector('.hcol-scroll');
    if (hcolScroll && window.createMomentumScroller) {
      var addVelocity = window.createMomentumScroller(hcolScroll);
      hcolScroll.addEventListener('wheel', function (event) {
        if (portraitQuery.matches) return;
        if (Math.abs(event.deltaX) >= Math.abs(event.deltaY)) return;
        var maxScrollLeft = hcolScroll.scrollWidth - hcolScroll.clientWidth;
        if (maxScrollLeft <= 0) return;
        event.preventDefault();
        addVelocity(-event.deltaY);
      }, { passive: false });
    }
  })();
</script>
