<div id="pheader" class="pheader">
<div class="twelve columns">
  <div class="row">
    <div class="nine columns nav left">
      <%- partial('partial/_nav-menu') %>
    </div>
  </div>
</div>

<div class="row">
  <div class="two columns" style="max-width: 50px">
    <h3 class="mt-2 mb-2 mode">
      <div data-theme-role="dark" onclick="setDarkMode(true)"><%= theme.switch_dark %></div>
      <div data-theme-role="light" onclick="setDarkMode(false)" class="hidden"><%= theme.switch_light %></div>
    </h3>
  </div>

  <div class="six columns">
    <h3 class="mb-2" style="font-size: 1.67rem">
      <%= theme.title %>
    </h3>
  </div>

</div>

<div class="row mb-2">
  <div class="twelve columns">
    <img src="<%= config.root %>images/pheader.svg"
         alt="Logo"
         style="max-width: 128px; height: auto;"
         class="noshadow"
         id="logoLight"/>
    <img src="<%= config.root %>images/pheader_dark.svg"
         alt="Logo"
         style="max-width: 128px; height: auto;"
         class="noshadow"
         id="logoDark"/>
  </div>
</div>
</div>