<div id="pheader" class="pheader">
<div class="twelve columns">
  <div class="row">
    <div class="nine columns nav left">
      <a href="<%= config.root %>"  class="ml">Home</a>
      <% for (name in theme.menu) { %>
        <% if (theme.menu[name]) { %>
        <a href="<%- url_for(theme.menu[name]) %>" class="ml"><%- name %></a>
        <% } %>
      <% } %>
      <% if (theme.email) { %>
        <% if (typeof obfuscate === "function") { %>
          <a href="mailto:<%- obfuscate(theme.email) %>" target="_blank" class="ml">Email</a>
        <% } else { %>
          <a href="mailto:<%= theme.email %>" target="_blank" class="ml">Email</a>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<div class="row">
  <div class="two columns" style="max-width: 50px">
    <h3 class="mt-2 mb-2 mode">
      <div onclick=setDarkMode(true) id="darkBtn"><%= theme.switch_dark %></div>
      <div onclick=setDarkMode(false) id="lightBtn" class=hidden><%= theme.switch_light %></div>
      <script >
  (function () {
  var media = window.matchMedia('(prefers-color-scheme: dark)');

  function applyTheme(isDark) {
    var darkBtn = document.getElementById('darkBtn');
    var lightBtn = document.getElementById('lightBtn');

    // Apply body class deterministically
    document.body.classList.toggle('darkmode', isDark);

    // Toggle button visibility using the existing `hidden` class
    if (darkBtn && lightBtn) {
      if (isDark) {
        lightBtn.classList.remove('hidden');
        darkBtn.classList.add('hidden');
      } else {
        lightBtn.classList.add('hidden');
        darkBtn.classList.remove('hidden');
      }
    }
  }

  // Expose a stable setter for user clicks (pins preference)
  window.setDarkMode = function (isDark) {
    localStorage.setItem('preferredTheme', isDark ? 'dark' : 'light');
    applyTheme(isDark);
  };

  function initTheme() {
    var stored = localStorage.getItem('preferredTheme');
    if (stored === 'dark') return applyTheme(true);
    if (stored === 'light') return applyTheme(false);
    // No stored preference: follow system
    return applyTheme(media.matches);
  }

  // Live update when following system (no stored preference)
  media.addEventListener('change', function (e) {
    if (!localStorage.getItem('preferredTheme')) {
      applyTheme(e.matches);
    }
  });

  // Initial paint
  initTheme();
})();
      </script>
    </h3>
  </div>

  <div class="six columns ml-1">
    <h3 class="mb-2">
      <%= theme.title %>
    </h3>
  </div>

</div>

<div class="row mb-2">
  <div class="twelve columns">
    <img src="<%= config.root %>images/pheader.avif"
         alt="Logo"
         style="max-width: 128px; height: auto;"
         class="noshadow"
         id="logoLight"/>
    <img src="<%= config.root %>images/pheader_dark.avif"
         alt="Logo"
         style="max-width: 128px; height: auto;"
         class="noshadow"
         id="logoDark"/>
  </div>
</div>
</div>