<script>
  (function () {
    // ========================================================================
    // POST EMBED PREVIEW
    // Inline preview for regular posts.
    // ========================================================================

    // --- Configuration ---
    const MAX_PREVIEW_BLOCKS = 3; 
    const THEME_TCOLOR = '#<%- theme.tcolor %>';
    const PRESET_HEIGHT_FLOOR = 240;
    const PRESET_HEIGHT_CEILING = 720;
    const PRESET_HEIGHT_RATIO = 0.66;
    
    // Internal constants
    const EMBED_FIT_DELAYS_AFTER_LOAD = [90, 240, 480];
    const EMBED_FIT_DELAYS_AFTER_REVEAL = [120, 320, 680, 1200];
    const ANIM_SAFETY_MS = 280;
    const INSERT_BLOCK_SELECTOR = 'p, li, blockquote, h3, h4, summary, center';

    // Module state
    let openPanel = null;
    let openLink = null;
    let clickToken = 0;
    let parsing = false;
    const prefetchCache = new Map();

    const styleHrefs = [...document.querySelectorAll('link[rel="stylesheet"]')]
      .map(link => link.getAttribute('href'))
      .filter(Boolean);

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeInlineScript(text) {
      return String(text || '').replace(/<\/script/gi, '<\\/script');
    }

    function isPostDetailLink(anchor) {
      if (!anchor?.href) return false;
      if (anchor.closest('.yoi-float-nav') || anchor.closest('.yoi-inline-panel')) return false;
      if (anchor.hasAttribute('download')) return false;

      const rawHref = anchor.getAttribute('href') || '';
      if (!rawHref || rawHref.charAt(0) === '#') return false;

      let url;
      try { url = new URL(anchor.href, window.location.href); }
      catch (e) { return false; }

      if (url.origin !== window.location.origin) return false;
      
      const isPost = /^\/\d{4}-\d{2}\/[^/]+\/?$/.test(url.pathname);
      if (!isPost) return false;
      if (url.pathname.startsWith('/Works/Yoishigure/')) return false;
      
      return true;
    }

    function buildEmbedHtml(contentHtml, title, url, isFragment) {
      const cssLinks = styleHrefs
        .map(href => `<link rel="stylesheet" href="${escapeHtml(href)}">`)
        .join('\n');

      const themeBootstrap = `(function () {
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  var stored = null;
  try { stored = localStorage.getItem("preferredTheme"); } catch (e) {}
  var isDark = stored === "dark" || (stored !== "light" && media.matches);
  if (isDark) {
    document.documentElement.classList.add("darkmode");
    if (document.body) document.body.classList.add("darkmode");
  }
})();`;

      return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<base href="${escapeHtml(window.location.origin + '/')}">
<title>${escapeHtml(title || 'Post Preview')}</title>
${cssLinks}
<style>
  html, body {
    margin: 0; padding: 0;
    background: transparent;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0 !important;
    height: auto !important;
  }
  body {
    display: block !important;
  }
  .trans {
    padding: 0;
    animation: none !important;
  }
  a:not(.icon) {
    --link-hover-accent: ${THEME_TCOLOR};
    text-decoration-color: var(--link-hover-accent);
    background-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 50%,
      var(--link-hover-accent) 50%
    );
    background-repeat: no-repeat;
    background-size: 100% calc(200% + 2px);
    background-position: 0 0;
    transition: color 0.2s ease-out, background-position 0.2s ease-out;
    color: inherit;
  }
  a:not(.icon) > strong, a:not(.icon) > b {
    background-image: inherit;
    background-size: inherit;
    background-position: inherit;
    background-repeat: inherit;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  a:not(.icon):hover {
    background-position: 0 100%;
    color: #E9E6E2;
  }
  a:not(.icon):hover > strong, a:not(.icon):hover > b {
    background-position: inherit;
    border-radius: 2px;
  }
  blockquote {
    border-left: 8px solid ${THEME_TCOLOR} !important;
    background-color: rgba(148, 148, 149, 0.08);
  }
  .yoi-embed-content > :first-child {
    margin-top: 1.5rem !important;
  }
  html.darkmode { color: rgb(151, 154, 156); }
  html.darkmode a:not(.icon) { color: rgb(151, 154, 156); }
</style>
<script>${safeInlineScript(themeBootstrap)}<\/script>
</head>
<body class="page-post-preview">
<div class="container">
  <div class="row">
    <div>
      <div class="trans">
        <div class="yoi-embed-content">
          ${contentHtml}
        </div>
        <p><strong><a href="${escapeHtml(url)}" target="_blank">CONTINUE READING${title ? ` ${escapeHtml(title)}` : ''}</a></strong></p>
      </div>
    </div>
  </div>
</div>
</body>
</html>`;
    }

    function fetchPostContent(pathname, hash) {
      const cacheKey = pathname + (hash || '');
      if (prefetchCache.has(cacheKey)) return prefetchCache.get(cacheKey);
      
      const promise = fetch(pathname, { credentials: 'same-origin' })
        .then(r => { if (!r.ok) throw new Error('fetch failed'); return r.text(); })
        .then(html => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const title = doc.querySelector('h2.mt-3')?.innerText || doc.title;
          const article = doc.querySelector('.trans') || doc.body;
          
          let startNode = null;
          if (hash) {
            const textMatch = hash.match(/:~:text=([^&]+)/);
            if (textMatch) {
              const textStart = decodeURIComponent(textMatch[1].split(',')[0]);
              const walker = doc.createTreeWalker(article, NodeFilter.SHOW_TEXT, null, false);
              let node;
              while (node = walker.nextNode()) {
                if (node.textContent.includes(textStart)) {
                  startNode = node.parentElement;
                  const blockParent = startNode.closest(INSERT_BLOCK_SELECTOR);
                  if (blockParent) startNode = blockParent;
                  break;
                }
              }
            }
            
            if (!startNode) {
              const id = decodeURIComponent(hash.substring(1)).split(':~:')[0];
              if (id) {
                startNode = doc.getElementById(id);
                if (startNode && startNode.classList.contains('headerlink')) {
                  startNode = startNode.parentElement;
                }
              }
            }
          }
          
          if (!startNode) {
            startNode = doc.querySelector('h2.mt-3');
          }
          
          const endNode = doc.querySelector('.post-meta');
          const contentNodes = [];
          
          if (startNode) {
            let n = /^H[1-6]$/.test(startNode.tagName) ? startNode.nextElementSibling : startNode;
            let count = 0;
            
            while (n && n !== endNode && count < MAX_PREVIEW_BLOCKS) {
              if (n.tagName === 'STYLE' || n.tagName === 'SCRIPT' || /^H[1-6]$/.test(n.tagName)) {
                n = n.nextElementSibling;
                continue;
              }

              if (['P', 'BLOCKQUOTE', 'UL', 'OL', 'TABLE', 'DETAILS', 'CENTER'].includes(n.tagName)) {
                contentNodes.push(n.outerHTML);
                count++;
              } else if (n.tagName === 'IMG' || n.classList.contains('exif-para')) {
                contentNodes.push(n.outerHTML);
                count++;
              }
              n = n.nextElementSibling;
            }
          }
          
          return {
            contentHtml: contentNodes.join(''),
            title: title
          };
        });
      prefetchCache.set(pathname, promise);
      return promise;
    }

    function fitFrameHeightToContent(panel, frame) {
      if (!frame.contentDocument) return;
      const doc = frame.contentDocument;
      const measured = doc.body ? Math.ceil(doc.body.scrollHeight) : 0;
      if (!measured) return;
      const maxHeight = Math.floor(window.innerHeight * 0.86);
      frame.style.height = Math.min(maxHeight, Math.max(PRESET_HEIGHT_FLOOR, measured + 2)) + 'px';
      if (panel.dataset.heightLocked === 'true') {
        panel.style.height = panel.scrollHeight + 'px';
      }
    }

    function createPanel(href) {
      const panel = document.createElement('div');
      panel.className = 'yoi-inline-panel';
      panel.dataset.href = href;
      const inner = document.createElement('div');
      inner.className = 'yoi-inline-panel__inner';
      const iframe = document.createElement('iframe');
      iframe.className = 'yoi-inline-panel__frame';
      iframe.loading = 'lazy';
      iframe.title = 'Post preview';
      inner.appendChild(iframe);
      panel.appendChild(inner);
      return { panel, iframe };
    }

    function findInsertionBlock(link) {
      const block = link.closest('p, li, blockquote, h3, h4, h5, h6');
      if (block) {
        block.classList.add('yoi-inline-panel-active-block');
        return block;
      }
      return link;
    }

    function collapseAndRemove(panel, link) {
      const startH = panel.getBoundingClientRect().height;
      panel.style.height = startH + 'px';
      void panel.offsetHeight;
      panel.style.height = '0';
      if (link) link.classList.remove('yoi-inline-panel-open-link');
      const activeBlock = link.closest('.yoi-inline-panel-active-block');
      if (activeBlock) activeBlock.classList.remove('yoi-inline-panel-active-block');
      const followingSibling = panel.nextElementSibling;
      if (followingSibling) followingSibling.classList.remove('yoi-inline-panel-following');
      let removed = false;
      const finalize = () => {
        if (removed) return;
        removed = true;
        panel.remove();
      };
      panel.addEventListener('transitionend', e => {
        if (e.propertyName === 'height') finalize();
      }, { once: true });
      setTimeout(finalize, ANIM_SAFETY_MS);
    }

    async function openOrSwitch(link) {
      const url = new URL(link.href, window.location.href);
      const token = ++clickToken;
      parsing = true;

      const { panel, iframe } = createPanel(link.getAttribute('href'));
      const target = findInsertionBlock(link);
      target.parentNode.insertBefore(panel, target.nextSibling);
      void panel.offsetHeight;

      link.classList.add('yoi-inline-panel-open-link');
      const followingSibling = panel.nextElementSibling;
      if (followingSibling) followingSibling.classList.add('yoi-inline-panel-following');

      const previousPanel = openPanel;
      const previousLink = openLink;
      if (previousPanel && previousPanel !== panel) {
        collapseAndRemove(previousPanel, previousLink);
      }

      openPanel = panel;
      openLink = link;

      try {
        const { contentHtml, title } = await fetchPostContent(url.pathname, url.hash);
        if (token !== clickToken) return;

        const isFragment = !!url.hash;
        const srcdoc = buildEmbedHtml(contentHtml, title || link.textContent || '', url.href, isFragment);

        const presetHeight = Math.max(
          PRESET_HEIGHT_FLOOR,
          Math.min(Math.floor(window.innerHeight * PRESET_HEIGHT_RATIO), PRESET_HEIGHT_CEILING)
        );
        iframe.style.height = presetHeight + 'px';

        iframe.addEventListener('load', function onLoad() {
          if (token !== clickToken) return;

          const reveal = () => {
            if (token !== clickToken) return;
            fitFrameHeightToContent(panel, iframe);

            panel.dataset.heightLocked = 'true';
            panel.style.height = panel.scrollHeight + 'px';
            panel.classList.add('is-loaded');

            let unlocked = false;
            const unlock = () => {
              if (unlocked) return;
              unlocked = true;
              panel.style.height = 'auto';
              panel.dataset.heightLocked = 'false';
            };
            panel.addEventListener('transitionend', e => {
              if (e.propertyName === 'height') unlock();
            }, { once: true });
            setTimeout(unlock, ANIM_SAFETY_MS);

            [...EMBED_FIT_DELAYS_AFTER_LOAD, ...EMBED_FIT_DELAYS_AFTER_REVEAL].forEach(d =>
              setTimeout(() => {
                if (token === clickToken) fitFrameHeightToContent(panel, iframe);
              }, d)
            );
          };

          const frameDoc = iframe.contentDocument;
          if (frameDoc?.fonts?.ready?.then) {
            let revealed = false;
            const safety = setTimeout(() => { if (!revealed) { revealed = true; reveal(); } }, 600);
            const onReady = () => { if (!revealed) { revealed = true; clearTimeout(safety); reveal(); } };
            frameDoc.fonts.ready.then(onReady).catch(onReady);
          } else {
            setTimeout(reveal, 160);
          }
        }, { once: true });

        iframe.srcdoc = srcdoc;
      } catch (e) {
        if (token === clickToken) {
          collapseAndRemove(panel, link);
          if (openPanel === panel) { openPanel = null; openLink = null; }
          window.open(url.href, '_blank');
        }
      } finally {
        if (token === clickToken) parsing = false;
      }
    }

    function closeOpen() {
      if (!openPanel) return;
      clickToken += 1;
      parsing = false;
      collapseAndRemove(openPanel, openLink);
      openPanel = null;
      openLink = null;
    }

    // ----- Event wiring -----

    document.addEventListener('click', event => {
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isPostDetailLink(anchor)) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (parsing) { event.preventDefault(); return; }

      event.preventDefault();

      if (openLink === anchor) {
        closeOpen();
      } else {
        openOrSwitch(anchor);
      }
    });

    document.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isPostDetailLink(anchor)) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      try {
        const url = new URL(anchor.href, window.location.href);
        fetchPostContent(url.pathname, url.hash);
      } catch (e) {}
    }, true);

    document.addEventListener('click', event => {
      if (!openPanel) return;
      if (event.defaultPrevented) return;
      if (openPanel.contains(event.target)) return;
      closeOpen();
    });

    window.addEventListener('resize', () => {
      if (!openPanel) return;
      const iframe = openPanel.querySelector('.yoi-inline-panel__frame');
      if (!iframe) return;
      fitFrameHeightToContent(openPanel, iframe);
      [120, 280].forEach(d => setTimeout(() => {
        if (openPanel) fitFrameHeightToContent(openPanel, iframe);
      }, d));
    });
  })();
</script>
