<div class="row">
  <div class="twelve columns left mb-3">
    <a class="post-title" id="random-article-link" href=""></a>
    <p class="bottom"><small id="random-article-date"></small></p>
  </div>
</div>
<script>
(function () {
  var list = <%- inline_random_posts() %>;
  if (!Array.isArray(list) || list.length === 0) return;
  var pick = list[Math.floor(Math.random() * list.length)];
  var link = document.getElementById('random-article-link');
  var dateEl = document.getElementById('random-article-date');
  if (link && pick.url) {
    link.href = pick.url;
    link.textContent = pick.title || '—';
  }
  if (dateEl && pick.date) {
    dateEl.textContent = new Date(pick.date).toLocaleDateString('en-US', {
      month: 'long', day: 'numeric', year: 'numeric'
    });
  }
})();
</script>
