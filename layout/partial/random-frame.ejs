<div class="random-frame">
  <a class="random-frame__link" id="random-frame-link" href="/Frames/">
    <img class="random-frame__img" id="random-frame-img" alt="">
  </a>
</div>
<script>
(function () {
  fetch('/random-frames.json')
    .then(function (r) { return r.json(); })
    .then(function (list) {
      if (!Array.isArray(list) || list.length === 0) return;
      var pick = list[Math.floor(Math.random() * list.length)];
      var img = document.getElementById('random-frame-img');
      var link = document.getElementById('random-frame-link');
      if (img && pick.src) img.src = pick.src;
      if (link && pick.link) link.href = pick.link;
    })
    .catch(function () { /* silent */ });
})();
</script>
