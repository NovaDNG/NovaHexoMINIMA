<script>
  (function () {
    var media = window.matchMedia('(prefers-color-scheme: dark)');
    var root = document.documentElement;

    function collectThemeButtons() {
      var darkBtns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-role="dark"]'));
      var lightBtns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-role="light"]'));

      var legacyDarkBtn = document.getElementById('darkBtn');
      var legacyLightBtn = document.getElementById('lightBtn');

      if (legacyDarkBtn && darkBtns.indexOf(legacyDarkBtn) === -1) {
        darkBtns.push(legacyDarkBtn);
      }
      if (legacyLightBtn && lightBtns.indexOf(legacyLightBtn) === -1) {
        lightBtns.push(legacyLightBtn);
      }

      return {
        darkBtns: darkBtns,
        lightBtns: lightBtns
      };
    }

    function syncThemeControls(isDark) {
      var controls = collectThemeButtons();
      var darkBtns = controls.darkBtns;
      var lightBtns = controls.lightBtns;
      if (!darkBtns.length && !lightBtns.length) return;

      if (isDark) {
        lightBtns.forEach(function (el) { el.classList.remove('hidden'); });
        darkBtns.forEach(function (el) { el.classList.add('hidden'); });
      } else {
        lightBtns.forEach(function (el) { el.classList.add('hidden'); });
        darkBtns.forEach(function (el) { el.classList.remove('hidden'); });
      }
    }

    function applyTheme(isDark) {
      root.classList.toggle('darkmode', isDark);
      if (document.body) {
        document.body.classList.toggle('darkmode', isDark);
      }
      syncThemeControls(isDark);
    }

    function preferredIsDark() {
      var stored = localStorage.getItem('preferredTheme');
      if (stored === 'dark') return true;
      if (stored === 'light') return false;
      return media.matches;
    }

    window.setDarkMode = function (isDark) {
      localStorage.setItem('preferredTheme', isDark ? 'dark' : 'light');
      applyTheme(isDark);
    };

    applyTheme(preferredIsDark());

    document.addEventListener('DOMContentLoaded', function () {
      applyTheme(root.classList.contains('darkmode'));
    }, { once: true });

    function handleSystemThemeChange(e) {
      if (!localStorage.getItem('preferredTheme')) {
        applyTheme(e.matches);
      }
    }

    if (typeof media.addEventListener === 'function') {
      media.addEventListener('change', handleSystemThemeChange);
    } else if (typeof media.addListener === 'function') {
      media.addListener(handleSystemThemeChange);
    }
  })();
</script>
