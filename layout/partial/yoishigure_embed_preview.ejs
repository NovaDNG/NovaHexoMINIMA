<div class="yoi-embed-modal" hidden aria-hidden="true">
  <div class="yoi-embed-modal__backdrop" data-yoi-embed-close></div>
  <div class="yoi-embed-modal__dialog" role="dialog" aria-modal="true" aria-label="Tategaki preview">
    <div class="yoi-embed-modal__toolbar">
      <button type="button" class="yoi-embed-modal__close" data-yoi-embed-close aria-label="關閉">×</button>
    </div>
    <iframe class="yoi-embed-modal__frame" title="Tategaki preview" loading="lazy"></iframe>
  </div>
</div>

<script>
  (function () {
    var modal = document.querySelector('.yoi-embed-modal');
    if (!modal) return;

    var frame = modal.querySelector('.yoi-embed-modal__frame');
    var closeTriggers = Array.prototype.slice.call(modal.querySelectorAll('[data-yoi-embed-close]'));
    var parsing = false;
    var clickToken = 0;
    var openingLink = null;
    var fitTimer = 0;
    var closeTimer = 0;
    var embedPaneHeightPx = 0;
    var EMBED_CLOSE_ANIM_MS = 200;
    var MIN_TATEGAKI_WIDTH = 920;
    var EMBED_VIEWPORT_RATIO = 0.94;
    var EMBED_DEFAULT_WIDTH = 1120;
    var EMBED_DEFAULT_HEIGHT_RATIO = 0.66;

    var styleHrefs = Array.prototype.slice.call(document.querySelectorAll('link[rel="stylesheet"]'))
      .map(function (link) { return link.getAttribute('href'); })
      .filter(Boolean);

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeInlineScript(text) {
      return String(text || '').replace(/<\/script/gi, '<\\/script');
    }

    function isYoishigureDetailLink(anchor) {
      if (!anchor || !anchor.href) return false;
      if (anchor.closest('.yoi-float-nav')) return false;
      if (anchor.closest('.yoi-embed-modal')) return false;
      if (anchor.hasAttribute('download')) return false;

      var rawHref = anchor.getAttribute('href') || '';
      if (!rawHref || rawHref.charAt(0) === '#') return false;

      var url;
      try {
        url = new URL(anchor.href, window.location.href);
      } catch (e) {
        return false;
      }

      if (url.origin !== window.location.origin) return false;
      if (!/^\/Works\/Yoishigure\//.test(url.pathname)) return false;
      if (/\/Works\/Yoishigure\/?$/i.test(url.pathname)) return false;
      if (/\.m4a$/i.test(url.pathname)) return false;

      return true;
    }

    function findTategakiScript(doc) {
      var el = doc.querySelector('script[data-tategaki-script]');
      return el ? (el.textContent || '') : '';
    }

    function canOpenEmbedInViewport() {
      return Math.floor(window.innerWidth * EMBED_VIEWPORT_RATIO) >= MIN_TATEGAKI_WIDTH;
    }

    function setOpeningState(next) {
      if (next) {
        document.documentElement.classList.add('yoi-embed-opening');
      } else {
        document.documentElement.classList.remove('yoi-embed-opening');
      }
    }

    function setOpeningLink(anchor) {
      clearOpeningLink();
      openingLink = anchor;
      openingLink.classList.add('yoi-embed-opening-link');
      openingLink.style.setProperty('transition', 'none', 'important');
      var computed = window.getComputedStyle(openingLink);
      openingLink.style.setProperty('color', computed.color, 'important');
      openingLink.style.setProperty('background-image', computed.backgroundImage, 'important');
      openingLink.style.setProperty('background-position', computed.backgroundPosition, 'important');
      openingLink.style.setProperty('background-size', computed.backgroundSize, 'important');
      openingLink.style.setProperty('text-decoration-line', computed.textDecorationLine, 'important');
      openingLink.style.setProperty('text-decoration-color', computed.textDecorationColor, 'important');
      openingLink.style.setProperty('text-decoration-style', computed.textDecorationStyle, 'important');
      openingLink.style.setProperty('text-decoration-thickness', computed.textDecorationThickness, 'important');
    }

    function clearOpeningLink() {
      if (!openingLink) return;
      openingLink.classList.remove('yoi-embed-opening-link');
      openingLink.style.removeProperty('background-image');
      openingLink.style.removeProperty('background-position');
      openingLink.style.removeProperty('background-size');
      openingLink.style.removeProperty('transition');
      openingLink.style.removeProperty('color');
      openingLink.style.removeProperty('text-decoration-line');
      openingLink.style.removeProperty('text-decoration-color');
      openingLink.style.removeProperty('text-decoration-style');
      openingLink.style.removeProperty('text-decoration-thickness');
      openingLink = null;
    }

    function computeEmbedPaneHeight() {
      return Math.max(300, Math.min(800, Math.floor(window.innerHeight * 0.64)));
    }

    function applyFramePresetSize() {
      var maxWidth = Math.floor(window.innerWidth * EMBED_VIEWPORT_RATIO);
      var maxHeight = Math.floor(window.innerHeight * 0.86);
      var width = Math.min(maxWidth, Math.max(MIN_TATEGAKI_WIDTH, EMBED_DEFAULT_WIDTH));
      embedPaneHeightPx = computeEmbedPaneHeight();
      var preferredHeight = Math.max(embedPaneHeightPx + 8, Math.floor(window.innerHeight * EMBED_DEFAULT_HEIGHT_RATIO));
      var height = Math.min(maxHeight, Math.max(460, preferredHeight));
      frame.style.width = width + 'px';
      frame.style.height = height + 'px';
      frame.style.opacity = '0';
    }

    function buildEmbedHtml(stageHtml, scriptText, title, paneHeightPx) {
      var cssLinks = styleHrefs.map(function (href) {
        return '<link rel="stylesheet" href="' + escapeHtml(href) + '">';
      }).join('\n');

      var themeBootstrap = [
        '(function () {',
        '  var media = window.matchMedia("(prefers-color-scheme: dark)");',
        '  var stored = null;',
        '  try { stored = localStorage.getItem("preferredTheme"); } catch (e) {}',
        '  var isDark = stored === "dark" || (stored !== "light" && media.matches);',
        '  if (isDark) {',
        '    document.documentElement.classList.add("darkmode");',
        '    if (document.body) document.body.classList.add("darkmode");',
        '  }',
        '})();'
      ].join('\n');

      return [
        '<!DOCTYPE html>',
        '<html lang="en">',
        '<head>',
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width, initial-scale=1">',
        '<base href="' + escapeHtml(window.location.origin + '/') + '">',
        '<title>' + escapeHtml(title || 'Tategaki Preview') + '</title>',
        cssLinks,
        '<style>',
        '  html, body {',
        '    margin: 0;',
        '    padding: 0;',
        '    background: transparent;',
        '    overflow: auto;',
        '    min-height: 0 !important;',
        '    height: auto !important;',
        '  }',
        '  .yoi-embed-root {',
        '    width: 100%;',
        '  }',
        '  .yoi-embed-root .tategaki-stage {',
        '    width: 100% !important;',
        '    max-width: none !important;',
        '    margin-top: 0 !important;',
        '    margin-bottom: 0 !important;',
        '    margin-left: 0 !important;',
        '    margin-right: 0 !important;',
        '  }',
        '  .yoi-embed-root .tategaki-scroll {',
        '    overflow-x: overlay !important;',
        '    overflow-y: hidden !important;',
        '    scrollbar-gutter: auto !important;',
        '    padding-bottom: 0 !important;',
        '  }',
        '</style>',
        '<script>' + safeInlineScript(themeBootstrap) + '<\/script>',
        '</head>',
        '<body class="page-yoishigure page-yoishigure-sub">',
        '<div class="yoi-embed-root">',
        stageHtml,
        '</div>',
        scriptText ? '<script>' + safeInlineScript(scriptText) + '<\/script>' : '',
        '</body>',
        '</html>'
      ].join('\n');
    }

    function fitFrameHeightToContent(token) {
      if (token !== clickToken) return;
      if (!frame || !frame.contentDocument) return;

      var doc = frame.contentDocument;
      var root = doc.querySelector('.yoi-embed-root');
      var body = doc.body;
      var html = doc.documentElement;
      var measured = 0;

      if (root && root.getBoundingClientRect) {
        measured = Math.ceil(root.getBoundingClientRect().height);
      }
      if (!measured) {
        measured = Math.max(
          body ? Math.ceil(body.scrollHeight) : 0,
          html ? Math.ceil(html.scrollHeight) : 0
        );
      }
      if (!measured) return;

      var maxHeight = Math.floor(window.innerHeight * 0.86);
      var targetHeight = Math.min(maxHeight, Math.max(420, measured + 2));
      frame.style.height = targetHeight + 'px';
    }

    function openModal() {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.documentElement.classList.add('yoi-embed-open');
      modal.classList.remove('is-visible');
      requestAnimationFrame(function () {
        modal.classList.add('is-visible');
      });
    }

    function finalizeCloseModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      frame.removeAttribute('src');
      frame.removeAttribute('srcdoc');
      frame.style.width = '';
      frame.style.height = '';
      frame.style.opacity = '';
      if (fitTimer) {
        window.clearTimeout(fitTimer);
        fitTimer = 0;
      }
      parsing = false;
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.documentElement.classList.remove('yoi-embed-open');
      setOpeningState(false);
      clearOpeningLink();
    }

    function closeModal(immediate) {
      clickToken += 1;
      parsing = false;
      modal.classList.remove('is-visible');
      frame.style.opacity = '0';

      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }

      if (immediate === true) {
        finalizeCloseModal();
        return;
      }

      closeTimer = window.setTimeout(function () {
        closeTimer = 0;
        finalizeCloseModal();
      }, EMBED_CLOSE_ANIM_MS);
    }

    async function openPreview(anchor) {
      var url = new URL(anchor.href, window.location.href);
      var token = ++clickToken;
      parsing = true;
      applyFramePresetSize();
      openModal();
      frame.removeAttribute('src');
      frame.removeAttribute('srcdoc');
      if (anchor.blur) anchor.blur();

      try {
        var response = await fetch(url.pathname, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('Fetch failed');

        var html = await response.text();
        if (token !== clickToken) return;

        var doc = new DOMParser().parseFromString(html, 'text/html');
        var stage = doc.querySelector('.tategaki-stage');
        if (!stage) {
          closeModal(true);
          window.location.href = url.href;
          return;
        }

        var scriptText = findTategakiScript(doc);
        var embedHtml = buildEmbedHtml(
          stage.outerHTML,
          scriptText,
          doc.title || anchor.textContent || '',
          embedPaneHeightPx || computeEmbedPaneHeight()
        );
        frame.addEventListener('load', function onFrameLoad() {
          if (token !== clickToken) return;
          fitFrameHeightToContent(token);

          function revealFrame() {
            if (token !== clickToken) return;
            fitFrameHeightToContent(token);
            frame.style.opacity = '1';
          }

          var frameDoc = frame.contentDocument;
          var fontsReady = frameDoc && frameDoc.fonts && frameDoc.fonts.ready && typeof frameDoc.fonts.ready.then === 'function';

          if (fontsReady) {
            // Reveal after fonts load (height is final), with a safety timeout.
            var revealed = false;
            var safetyTimer = window.setTimeout(function () {
              if (!revealed) { revealed = true; revealFrame(); }
            }, 600);
            frameDoc.fonts.ready.then(function () {
              if (!revealed) { revealed = true; window.clearTimeout(safetyTimer); revealFrame(); }
            }).catch(function () {
              if (!revealed) { revealed = true; window.clearTimeout(safetyTimer); revealFrame(); }
            });
          } else {
            // No font API — refit after a short delay then reveal.
            window.setTimeout(revealFrame, 160);
          }
        }, { once: true });
        frame.srcdoc = embedHtml;
      } catch (e) {
        closeModal(true);
        window.location.href = url.href;
      } finally {
        if (token === clickToken) parsing = false;
      }
    }

    closeTriggers.forEach(function (trigger) {
      trigger.addEventListener('click', function (event) {
        if (event) event.preventDefault();
        closeModal(false);
      });
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });

    document.addEventListener('click', function (event) {
      var anchor = event.target && event.target.closest ? event.target.closest('a') : null;
      if (!anchor) return;
      if (!isYoishigureDetailLink(anchor)) return;
      // Pointer interactions are handled in pointerdown; keep click for keyboard activation.
      if (event.detail !== 0) return;
      if (!canOpenEmbedInViewport()) {
        setOpeningState(false);
        clearOpeningLink();
        return;
      }
      if (parsing) {
        event.preventDefault();
        return;
      }

      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        setOpeningState(false);
        clearOpeningLink();
        return;
      }

      setOpeningLink(anchor);
      setOpeningState(true);
      event.preventDefault();
      openPreview(anchor);
    });

    document.addEventListener('pointerdown', function (event) {
      if (event.button !== 0) return;
      var anchor = event.target && event.target.closest ? event.target.closest('a') : null;
      if (!anchor) return;
      if (!isYoishigureDetailLink(anchor)) return;
      if (!canOpenEmbedInViewport()) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (parsing) return;

      setOpeningLink(anchor);
      setOpeningState(true);
      event.preventDefault();
      openPreview(anchor);
    }, true);
  })();
</script>
