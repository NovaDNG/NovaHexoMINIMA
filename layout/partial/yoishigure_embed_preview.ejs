<script>
  (function () {
    // ========================================================================
    // YOISHIGURE — INLINE LYRICS PANEL
    // Loaded on pages with `yoishigure_index: true` or `tategaki: true`.
    // Click on a /Works/Yoishigure/<song> link → fetch song HTML, extract
    // .tategaki-stage, render in an iframe inside an inline recessed panel
    // inserted as the next sibling of the clicked link's block ancestor.
    // ========================================================================

    const MIN_TATEGAKI_WIDTH = 920;
    const EMBED_VIEWPORT_RATIO = 0.94;
    const EMBED_FIT_DELAYS_AFTER_LOAD = [90, 240, 480];
    const EMBED_FIT_DELAYS_AFTER_REVEAL = [120, 320, 680, 1200];
    const ANIM_SAFETY_MS = 280;
    const PRESET_HEIGHT_FLOOR = 420;
    const PRESET_HEIGHT_CEILING = 800;
    const PRESET_HEIGHT_RATIO = 0.66;
    const INSERT_BLOCK_SELECTOR = 'p, li, blockquote, h3, h4, summary, center';

    // Module state
    let openPanel = null;
    let openLink = null;
    let clickToken = 0;
    let parsing = false;
    const prefetchCache = new Map();

    const styleHrefs = [...document.querySelectorAll('link[rel="stylesheet"]')]
      .map(link => link.getAttribute('href'))
      .filter(Boolean);

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeInlineScript(text) {
      return String(text || '').replace(/<\/script/gi, '<\\/script');
    }

    function isYoishigureDetailLink(anchor) {
      if (!anchor?.href) return false;
      if (anchor.closest('.yoi-float-nav') || anchor.closest('.yoi-inline-panel')) return false;
      if (anchor.hasAttribute('download')) return false;

      const rawHref = anchor.getAttribute('href') || '';
      if (!rawHref || rawHref.charAt(0) === '#') return false;

      let url;
      try { url = new URL(anchor.href, window.location.href); }
      catch (e) { return false; }

      if (url.origin !== window.location.origin) return false;
      if (!/^\/Works\/Yoishigure\//.test(url.pathname)) return false;
      if (/\/Works\/Yoishigure\/?$/i.test(url.pathname)) return false;
      if (/\.m4a$/i.test(url.pathname)) return false;
      return true;
    }

    function canOpenEmbedInViewport() {
      return Math.floor(window.innerWidth * EMBED_VIEWPORT_RATIO) >= MIN_TATEGAKI_WIDTH;
    }

    function findTategakiScript(doc) {
      const script = [...doc.querySelectorAll('script')].find(s =>
        (s.textContent || '').includes("var mobileQuery = window.matchMedia('(max-width: 900px)')")
      );
      return script ? script.textContent : '';
    }

    function buildEmbedHtml(stageHtml, scriptText, title) {
      const cssLinks = styleHrefs
        .map(href => `<link rel="stylesheet" href="${escapeHtml(href)}">`)
        .join('\n');

      const themeBootstrap = `(function () {
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  var stored = null;
  try { stored = localStorage.getItem("preferredTheme"); } catch (e) {}
  var isDark = stored === "dark" || (stored !== "light" && media.matches);
  if (isDark) {
    document.documentElement.classList.add("darkmode");
    if (document.body) document.body.classList.add("darkmode");
  }
})();`;

      return `<!DOCTYPE html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<base href="${escapeHtml(window.location.origin + '/')}">
<title>${escapeHtml(title || 'Tategaki Preview')}</title>
${cssLinks}
<style>
  html, body {
    margin: 0; padding: 0;
    background: transparent;
    overflow: auto;
    min-height: 0 !important;
    height: auto !important;
  }
  .yoi-embed-root { width: 100%; }
  .yoi-embed-root .tategaki-stage {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
  }
  .yoi-embed-root .tategaki-scroll {
    overflow-x: overlay !important;
    overflow-y: hidden !important;
    scrollbar-gutter: auto !important;
    padding-bottom: 0 !important;
  }
</style>
<script>${safeInlineScript(themeBootstrap)}<\/script>
</head>
<body class="page-yoishigure page-yoishigure-sub">
<div class="yoi-embed-root">
${stageHtml}
</div>
${scriptText ? `<script>${safeInlineScript(scriptText)}<\/script>` : ''}
</body>
</html>`;
    }

    function fetchSongContent(pathname) {
      if (prefetchCache.has(pathname)) return prefetchCache.get(pathname);
      const promise = fetch(pathname, { credentials: 'same-origin' })
        .then(r => { if (!r.ok) throw new Error('fetch failed'); return r.text(); })
        .then(html => {
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const stage = doc.querySelector('.tategaki-stage');
          if (!stage) throw new Error('no tategaki-stage');
          return {
            stageHtml: stage.outerHTML,
            scriptText: findTategakiScript(doc),
            title: doc.title || ''
          };
        });
      prefetchCache.set(pathname, promise);
      return promise;
    }

    function fitFrameHeightToContent(panel, frame) {
      if (!frame.contentDocument) return;
      const doc = frame.contentDocument;
      const root = doc.querySelector('.yoi-embed-root');
      let measured = root ? Math.ceil(root.getBoundingClientRect().height) : 0;
      if (!measured) {
        measured = Math.max(
          doc.body ? Math.ceil(doc.body.scrollHeight) : 0,
          doc.documentElement ? Math.ceil(doc.documentElement.scrollHeight) : 0
        );
      }
      if (!measured) return;
      const maxHeight = Math.floor(window.innerHeight * 0.86);
      frame.style.height = Math.min(maxHeight, Math.max(420, measured + 2)) + 'px';
      // Sync panel height while it's still locked (during the initial expand)
      if (panel.dataset.heightLocked === 'true') {
        panel.style.height = panel.scrollHeight + 'px';
      }
    }

    function createPanel(href) {
      const panel = document.createElement('div');
      panel.className = 'yoi-inline-panel';
      panel.dataset.href = href;
      const iframe = document.createElement('iframe');
      iframe.className = 'yoi-inline-panel__frame';
      iframe.loading = 'lazy';
      iframe.title = 'Tategaki preview';
      panel.appendChild(iframe);
      return { panel, iframe };
    }

    function findInsertionTarget(link) {
      return link.closest(INSERT_BLOCK_SELECTOR) || link;
    }

    function collapseAndRemove(panel, link) {
      const startH = panel.getBoundingClientRect().height;
      panel.style.height = startH + 'px';
      void panel.offsetHeight; // force reflow so the explicit height is registered
      panel.style.height = '0';
      if (link) link.classList.remove('yoi-inline-panel-open-link');
      let removed = false;
      const finalize = () => {
        if (removed) return;
        removed = true;
        panel.remove();
      };
      panel.addEventListener('transitionend', e => {
        if (e.propertyName === 'height') finalize();
      }, { once: true });
      setTimeout(finalize, ANIM_SAFETY_MS);
    }

    async function openOrSwitch(link) {
      const url = new URL(link.href, window.location.href);
      const token = ++clickToken;
      parsing = true;

      const { panel, iframe } = createPanel(link.getAttribute('href'));
      const target = findInsertionTarget(link);
      target.parentNode.insertBefore(panel, target.nextSibling);
      void panel.offsetHeight; // ensure starting height:0 is registered before transition

      link.classList.add('yoi-inline-panel-open-link');

      // Simultaneously collapse previous panel (if any)
      const previousPanel = openPanel;
      const previousLink = openLink;
      if (previousPanel && previousPanel !== panel) {
        collapseAndRemove(previousPanel, previousLink);
      }

      openPanel = panel;
      openLink = link;

      try {
        const { stageHtml, scriptText, title } = await fetchSongContent(url.pathname);
        if (token !== clickToken) return;

        const srcdoc = buildEmbedHtml(stageHtml, scriptText, title || link.textContent || '');

        // Pre-size iframe BEFORE srcdoc so its contentWindow has real
        // dimensions when stylesheets evaluate. Without this, the iframe
        // loads at height:0 and the inside-iframe (max-width: 900px) media
        // query collapses tategaki to horizontal-tb mode.
        const presetHeight = Math.max(
          PRESET_HEIGHT_FLOOR,
          Math.min(Math.floor(window.innerHeight * PRESET_HEIGHT_RATIO), PRESET_HEIGHT_CEILING)
        );
        iframe.style.height = presetHeight + 'px';

        iframe.addEventListener('load', function onLoad() {
          if (token !== clickToken) return;

          const reveal = () => {
            if (token !== clickToken) return;
            fitFrameHeightToContent(panel, iframe);

            panel.dataset.heightLocked = 'true';
            panel.style.height = panel.scrollHeight + 'px';
            panel.classList.add('is-loaded');

            let unlocked = false;
            const unlock = () => {
              if (unlocked) return;
              unlocked = true;
              panel.style.height = 'auto';
              panel.dataset.heightLocked = 'false';
            };
            panel.addEventListener('transitionend', e => {
              if (e.propertyName === 'height') unlock();
            }, { once: true });
            setTimeout(unlock, ANIM_SAFETY_MS);

            [...EMBED_FIT_DELAYS_AFTER_LOAD, ...EMBED_FIT_DELAYS_AFTER_REVEAL].forEach(d =>
              setTimeout(() => {
                if (token === clickToken) fitFrameHeightToContent(panel, iframe);
              }, d)
            );
          };

          const frameDoc = iframe.contentDocument;
          if (frameDoc?.fonts?.ready?.then) {
            let revealed = false;
            const safety = setTimeout(() => { if (!revealed) { revealed = true; reveal(); } }, 600);
            const onReady = () => { if (!revealed) { revealed = true; clearTimeout(safety); reveal(); } };
            frameDoc.fonts.ready.then(onReady).catch(onReady);
          } else {
            setTimeout(reveal, 160);
          }
        }, { once: true });

        iframe.srcdoc = srcdoc;
      } catch (e) {
        if (token === clickToken) {
          collapseAndRemove(panel, link);
          if (openPanel === panel) { openPanel = null; openLink = null; }
          window.location.href = url.href;
        }
      } finally {
        if (token === clickToken) parsing = false;
      }
    }

    function closeOpen() {
      if (!openPanel) return;
      clickToken += 1;
      parsing = false;
      collapseAndRemove(openPanel, openLink);
      openPanel = null;
      openLink = null;
    }

    // ----- Event wiring -----

    // Link click: open / switch / toggle
    document.addEventListener('click', event => {
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isYoishigureDetailLink(anchor)) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!canOpenEmbedInViewport()) return;
      if (parsing) { event.preventDefault(); return; }

      event.preventDefault();

      if (openLink === anchor) {
        closeOpen();
      } else {
        openOrSwitch(anchor);
      }
    });

    // Pointerdown preload (warm fetch cache before click resolves)
    document.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isYoishigureDetailLink(anchor)) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (!canOpenEmbedInViewport()) return;
      try {
        const url = new URL(anchor.href, window.location.href);
        fetchSongContent(url.pathname);
      } catch (e) {}
    }, true);

    // Outside-click closes (runs after the link handler; defaultPrevented guard
    // skips clicks the link handler already acted on)
    document.addEventListener('click', event => {
      if (!openPanel) return;
      if (event.defaultPrevented) return;
      if (openPanel.contains(event.target)) return;
      closeOpen();
    });

    // Resize while open: re-fit iframe height
    window.addEventListener('resize', () => {
      if (!openPanel) return;
      const iframe = openPanel.querySelector('.yoi-inline-panel__frame');
      if (!iframe) return;
      fitFrameHeightToContent(openPanel, iframe);
      [120, 280].forEach(d => setTimeout(() => {
        if (openPanel) fitFrameHeightToContent(openPanel, iframe);
      }, d));
      // If the user dragged the viewport below the threshold while a panel is
      // open, close it cleanly — clicks below threshold then navigate normally.
      if (!canOpenEmbedInViewport()) closeOpen();
    });
  })();
</script>
