<div class="yoi-embed-modal" hidden aria-hidden="true">
  <div class="yoi-embed-modal__backdrop" data-yoi-embed-close></div>
  <div class="yoi-embed-modal__dialog" role="dialog" aria-modal="true" aria-label="Tategaki preview">
    <div class="yoi-embed-modal__toolbar">
      <button type="button" class="yoi-embed-modal__close" data-yoi-embed-close aria-label="關閉">⛌</button>
    </div>
    <iframe class="yoi-embed-modal__frame" title="Tategaki preview" loading="lazy"></iframe>
  </div>
</div>

<script>
  (function () {
    const modal = document.querySelector('.yoi-embed-modal');
    if (!modal) return;

    const frame = modal.querySelector('.yoi-embed-modal__frame');
    const dialog = modal.querySelector('.yoi-embed-modal__dialog');
    const closeTriggers = [...modal.querySelectorAll('[data-yoi-embed-close]')];
    let parsing = false;
    let clickToken = 0;
    let openingLink = null;
    let fitTimer = 0;
    let closeTimer = 0;
    let embedPaneHeightPx = 0;

    const EMBED_CLOSE_ANIM_MS = 200;
    const MIN_TATEGAKI_WIDTH = 920;
    const EMBED_VIEWPORT_RATIO = 0.94;
    const EMBED_DEFAULT_WIDTH = 1120;
    const EMBED_DEFAULT_HEIGHT_RATIO = 0.66;

    const styleHrefs = [...document.querySelectorAll('link[rel="stylesheet"]')]
      .map(link => link.getAttribute('href'))
      .filter(Boolean);

    function escapeHtml(text) {
      return String(text || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function safeInlineScript(text) {
      return String(text || '').replace(/<\/script/gi, '<\\/script');
    }

    function isYoishigureDetailLink(anchor) {
      if (!anchor?.href) return false;
      if (anchor.closest('.yoi-float-nav') || anchor.closest('.yoi-embed-modal')) return false;
      if (anchor.hasAttribute('download')) return false;

      const rawHref = anchor.getAttribute('href') || '';
      if (!rawHref || rawHref.charAt(0) === '#') return false;

      let url;
      try {
        url = new URL(anchor.href, window.location.href);
      } catch (e) {
        return false;
      }

      if (url.origin !== window.location.origin) return false;
      if (!/^\/Works\/Yoishigure\//.test(url.pathname)) return false;
      if (/\/Works\/Yoishigure\/?$/i.test(url.pathname)) return false;
      if (/\.m4a$/i.test(url.pathname)) return false;

      return true;
    }

    function findTategakiScript(doc) {
      const script = [...doc.querySelectorAll('script')].find(s =>
        (s.textContent || '').includes("var mobileQuery = window.matchMedia('(max-width: 900px)')")
      );
      return script ? script.textContent : '';
    }

    function canOpenEmbedInViewport() {
      return Math.floor(window.innerWidth * EMBED_VIEWPORT_RATIO) >= MIN_TATEGAKI_WIDTH;
    }

    function setOpeningState(next) {
      document.documentElement.classList.toggle('yoi-embed-opening', next);
    }

    function setOpeningLink(anchor) {
      clearOpeningLink();
      openingLink = anchor;
      openingLink.classList.add('yoi-embed-opening-link');
      openingLink.style.setProperty('transition', 'none', 'important');
      const computed = window.getComputedStyle(openingLink);
      openingLink.style.setProperty('color', computed.color, 'important');
      openingLink.style.setProperty('background-image', computed.backgroundImage, 'important');
      openingLink.style.setProperty('background-position', computed.backgroundPosition, 'important');
      openingLink.style.setProperty('background-size', computed.backgroundSize, 'important');
    }

    function clearOpeningLink() {
      if (!openingLink) return;
      openingLink.classList.remove('yoi-embed-opening-link');
      openingLink.style.removeProperty('background-image');
      openingLink.style.removeProperty('background-position');
      openingLink.style.removeProperty('background-size');
      openingLink.style.removeProperty('transition');
      openingLink.style.removeProperty('color');
      openingLink = null;
    }

    function computeEmbedPaneHeight() {
      return Math.max(300, Math.min(800, Math.floor(window.innerHeight * 0.64)));
    }

    function applyFramePresetSize() {
      const maxWidth = Math.floor(window.innerWidth * EMBED_VIEWPORT_RATIO);
      const maxHeight = Math.floor(window.innerHeight * 0.86);
      const width = Math.min(maxWidth, Math.max(MIN_TATEGAKI_WIDTH, EMBED_DEFAULT_WIDTH));
      embedPaneHeightPx = computeEmbedPaneHeight();
      const preferredHeight = Math.max(embedPaneHeightPx + 8, Math.floor(window.innerHeight * EMBED_DEFAULT_HEIGHT_RATIO));
      const height = Math.min(maxHeight, Math.max(460, preferredHeight));
      frame.style.width = width + 'px';
      frame.style.height = height + 'px';
      frame.style.opacity = '0';
    }

    function buildEmbedHtml(stageHtml, scriptText, title) {
      const cssLinks = styleHrefs
        .map(href => `<link rel="stylesheet" href="${escapeHtml(href)}">`)
        .join('\n');

      const themeBootstrap = `(function () {
  var media = window.matchMedia("(prefers-color-scheme: dark)");
  var stored = null;
  try { stored = localStorage.getItem("preferredTheme"); } catch (e) {}
  var isDark = stored === "dark" || (stored !== "light" && media.matches);
  if (isDark) {
    document.documentElement.classList.add("darkmode");
    if (document.body) document.body.classList.add("darkmode");
  }
})();`;

      return `<!DOCTYPE html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<base href="${escapeHtml(window.location.origin + '/')}">
<title>${escapeHtml(title || 'Tategaki Preview')}</title>
${cssLinks}
<style>
  html, body {
    margin: 0;
    padding: 0;
    background: transparent;
    overflow: auto;
    min-height: 0 !important;
    height: auto !important;
  }
  .yoi-embed-root {
    width: 100%;
  }
  .yoi-embed-root .tategaki-stage {
    width: 100% !important;
    max-width: none !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  .yoi-embed-root .tategaki-scroll {
    overflow-x: overlay !important;
    overflow-y: hidden !important;
    scrollbar-gutter: auto !important;
    padding-bottom: 0 !important;
  }
</style>
<script>${safeInlineScript(themeBootstrap)}<\/script>
</head>
<body class="page-yoishigure page-yoishigure-sub">
<div class="yoi-embed-root">
${stageHtml}
</div>
${scriptText ? `<script>${safeInlineScript(scriptText)}<\/script>` : ''}
</body>
</html>`;
    }

    function fitFrameHeightToContent(token) {
      if (token !== clickToken || !frame?.contentDocument) return;

      const doc = frame.contentDocument;
      const root = doc.querySelector('.yoi-embed-root');

      let measured = root ? Math.ceil(root.getBoundingClientRect().height) : 0;
      if (!measured) {
        measured = Math.max(
          doc.body ? Math.ceil(doc.body.scrollHeight) : 0,
          doc.documentElement ? Math.ceil(doc.documentElement.scrollHeight) : 0
        );
      }
      if (!measured) return;

      const maxHeight = Math.floor(window.innerHeight * 0.86);
      frame.style.height = Math.min(maxHeight, Math.max(420, measured + 2)) + 'px';
    }

    function openModal() {
      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      document.documentElement.classList.add('yoi-embed-open');
      modal.classList.remove('is-visible');
      // Keep dialog hidden until content is sized; backdrop fades in immediately.
      dialog.style.setProperty('opacity', '0', 'important');
      dialog.style.setProperty('transform', 'translateY(8px)', 'important');
      requestAnimationFrame(() => modal.classList.add('is-visible'));
    }

    function finalizeCloseModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      frame.removeAttribute('src');
      frame.removeAttribute('srcdoc');
      frame.style.width = '';
      frame.style.height = '';
      frame.style.opacity = '';
      dialog.style.removeProperty('opacity');
      dialog.style.removeProperty('transform');
      if (fitTimer) {
        window.clearTimeout(fitTimer);
        fitTimer = 0;
      }
      parsing = false;
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
      document.documentElement.classList.remove('yoi-embed-open');
      setOpeningState(false);
      clearOpeningLink();
    }

    function closeModal(immediate) {
      clickToken += 1;
      parsing = false;
      modal.classList.remove('is-visible');
      frame.style.opacity = '0';

      if (closeTimer) {
        window.clearTimeout(closeTimer);
        closeTimer = 0;
      }

      if (immediate === true) {
        finalizeCloseModal();
        return;
      }

      closeTimer = window.setTimeout(() => {
        closeTimer = 0;
        finalizeCloseModal();
      }, EMBED_CLOSE_ANIM_MS);
    }

    async function openPreview(anchor) {
      const url = new URL(anchor.href, window.location.href);
      const token = ++clickToken;
      parsing = true;
      applyFramePresetSize();
      openModal();
      frame.removeAttribute('src');
      frame.removeAttribute('srcdoc');
      anchor.blur?.();

      try {
        const response = await fetch(url.pathname, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('Fetch failed');

        const html = await response.text();
        if (token !== clickToken) return;

        const doc = new DOMParser().parseFromString(html, 'text/html');
        const stage = doc.querySelector('.tategaki-stage');
        if (!stage) {
          closeModal(true);
          window.location.href = url.href;
          return;
        }

        const embedHtml = buildEmbedHtml(
          stage.outerHTML,
          findTategakiScript(doc),
          doc.title || anchor.textContent || ''
        );

        frame.addEventListener('load', function onFrameLoad() {
          if (token !== clickToken) return;
          fitFrameHeightToContent(token);

          function revealFrame() {
            if (token !== clickToken) return;
            fitFrameHeightToContent(token);
            // Release dialog inline overrides so CSS transition fades it in.
            dialog.style.removeProperty('opacity');
            dialog.style.removeProperty('transform');
            frame.style.opacity = '1';
          }

          const frameDoc = frame.contentDocument;
          const fontsReady = typeof frameDoc?.fonts?.ready?.then === 'function';

          if (fontsReady) {
            // Reveal after fonts load (height is final), with a safety timeout.
            let revealed = false;
            const safetyTimer = window.setTimeout(() => {
              if (!revealed) { revealed = true; revealFrame(); }
            }, 600);
            const onReady = () => {
              if (!revealed) { revealed = true; window.clearTimeout(safetyTimer); revealFrame(); }
            };
            frameDoc.fonts.ready.then(onReady).catch(onReady);
          } else {
            // No font API — refit after a short delay then reveal.
            window.setTimeout(revealFrame, 160);
          }
        }, { once: true });

        frame.srcdoc = embedHtml;
      } catch (e) {
        closeModal(true);
        window.location.href = url.href;
      } finally {
        if (token === clickToken) parsing = false;
      }
    }

    closeTriggers.forEach(trigger => {
      trigger.addEventListener('click', event => {
        event?.preventDefault();
        closeModal(false);
      });
    });

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });

    document.addEventListener('click', event => {
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isYoishigureDetailLink(anchor)) return;
      if (!canOpenEmbedInViewport()) {
        setOpeningState(false);
        clearOpeningLink();
        return;
      }
      if (parsing) { event.preventDefault(); return; }
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        setOpeningState(false);
        clearOpeningLink();
        return;
      }
      setOpeningLink(anchor);
      setOpeningState(true);
      event.preventDefault();
      openPreview(anchor);
    });

    document.addEventListener('pointerdown', event => {
      if (event.button !== 0) return;
      const anchor = event.target?.closest?.('a');
      if (!anchor || !isYoishigureDetailLink(anchor)) return;
      if (!canOpenEmbedInViewport()) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (parsing) return;
      setOpeningLink(anchor);
      setOpeningState(true);
      event.preventDefault();
      openPreview(anchor);
    }, true);
  })();
</script>
